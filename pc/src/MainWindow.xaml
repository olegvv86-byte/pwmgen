<Window x:Class="POBEDA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ПОБЕДА" Width="900" Height="650" Background="#1e1e1e" WindowStartupLocation="CenterScreen"
        Icon="/app.ico">

    <DockPanel>
        <!-- Верхняя панель -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#333" Height="32">
            <Button x:Name="btnFile" Content="📄 FILE" Width="70" Margin="4,2" Click="btnFile_Click"/>
            <Button x:Name="btnWifi" Content="📶 WiFi" Width="70" Margin="4,2" Click="btnWifi_Click"/>
            <TextBlock x:Name="lblConn" Text="..." Foreground="#aaa" VerticalAlignment="Center" Margin="12,0"/>
        </StackPanel>

        <!-- Основная область -->
        <Grid>
            <!-- WebView2 -->
            <wv2:WebView2 x:Name="webView"/>

            <!-- Загрузочный оверлей -->
            <Grid x:Name="loadingOverlay" Background="#1e1e1e">
                <TextBlock x:Name="lblLoading" Text="Загрузка..." Foreground="White" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- WiFi-диалог -->
            <Grid x:Name="wifiOverlay" Background="#000000AA" Visibility="Collapsed">
                <Border Background="#2d2d2d" CornerRadius="6" Width="400" Height="150"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16">
                    <StackPanel>
                        <TextBlock Text="IP-адрес генератора" Foreground="White" FontSize="14" Margin="0,0,0,8"/>
                        <TextBox x:Name="txtIp" FontFamily="Consolas" FontSize="16" Padding="4" Text="192.168.4.1"/>
                        <TextBlock x:Name="lblWifiStatus" Text=" " Foreground="#bbb" FontSize="11" Margin="0,6,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="btnWifiAutosearch" Content="Автопоиск" Width="90" Margin="0,0,8,0" Click="btnWifiAutosearch_Click"/>
                            <Button x:Name="btnWifiCancel" Content="Отмена" Width="70" Margin="0,0,8,0" Click="btnWifiCancel_Click"/>
                            <Button x:Name="btnWifiConnect" Content="Подключить" Width="100" Background="#2e7d32" Foreground="White" Click="btnWifiConnect_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Редактор кода -->
            <Grid x:Name="editorOverlay" Background="#1e1e1e" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
                    <Button x:Name="btnOpen" Content="Открыть" Width="80" Margin="0,0,4,0" Click="btnOpen_Click"/>
                    <Button x:Name="btnSave" Content="Сохранить" Width="80" Margin="0,0,4,0" Click="btnSave_Click"/>
                    <Button x:Name="btnUpload" Content="⬆ Загрузить на Pico" Width="140" Margin="0,0,4,0" Background="#1565c0" Foreground="White" Click="btnUpload_Click"/>
                    <Button x:Name="btnRollback" Content="↩ Откат" Width="80" Margin="0,0,4,0" Click="btnRollback_Click"/>
                    <TextBlock x:Name="lblFileName" Text="(нет файла)" Foreground="#aaa" VerticalAlignment="Center" Margin="8,0"/>
                    <Button x:Name="btnCloseEditor" Content="✕ Закрыть" Width="80" Margin="0,0,0,0" Click="btnCloseEditor_Click"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtLineNums" Grid.Column="0" FontFamily="Consolas" FontSize="13"
                             IsReadOnly="True" Background="#111" Foreground="#555" Padding="4,0"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Hidden"
                             HorizontalScrollBarVisibility="Hidden" BorderThickness="0,0,1,0"
                             BorderBrush="#333" IsHitTestVisible="False" TextAlignment="Right"/>
                    <TextBox Grid.Column="1" x:Name="txtEditor" FontFamily="Consolas" FontSize="13"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#1a1a2e" Foreground="#eee" Padding="4,0"
                             TextChanged="txtEditor_TextChanged"/>
                </Grid>
                <ProgressBar Grid.Row="2" x:Name="prgUpload" Height="6" Margin="8,4" Maximum="100"/>
                <TextBox Grid.Row="3" x:Name="txtLog" FontFamily="Consolas" FontSize="11"
                         IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="#111" Foreground="#0f0" Margin="8,0,8,8"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
