<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GBO HEATER</AssemblyName>
    <RootNamespace>GboHeater</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WebView2Loader.dll — нативная библиотека, и в однофайловую сборку она по
         умолчанию НЕ попадает: рядом с exe должен лежать ещё и dll. Программу
         таскают по папкам, dll теряется, и exe падает при запуске. С этим
         флагом она зашивается внутрь и распаковывается во временную папку
         сама. Файл один, и класть его можно куда угодно. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\app\src\main\assets\index.html" Link="index.html" />
  </ItemGroup>
</Project>
