String calPointText(float p, float v) {
  if (p <= 0) return "не задана";
  return String(v, 2) + " В при " + String(p * 1000.0, 0) + " мВ";
}

/* Пересчитать наклон и сдвиг, когда обе точки на месте. */
bool calRecompute(String &why) {
  if (calLoP <= 0 || calHiP <= 0) { why = "нужна вторая точка"; return false; }
  float dp = calHiP - calLoP;
  if (fabs(dp) < 0.2) { why = "точки слишком близко, разведите по напряжению"; return false; }

  float a = (calHiV - calLoV) / dp;
  float b = calLoV - a * calLoP;
  if (a < DIVK_MIN || a > DIVK_MAX) { why = "наклон вне разумного, проверьте числа"; return false; }

  calA = a;
  calB = b;
  why = "наклон " + String(calA, 3) + ", сдвиг " + String(calB, 3);
  return true;
}

void handleCalPage() {
  String p = FPSTR(CAL_PAGE);
  p.replace("%VBAT%", vbatValid ? String(vbat, 2) : String("--"));
  p.replace("%MV%", String(vbatMv));
  p.replace("%A%", String(calA, 3));
  p.replace("%B%", String(calB, 3));
  p.replace("%MAXV%", String(ADC_LIN_MAX_MV / 1000.0 * calA + calB, 1));
  p.replace("%LO%", calPointText(calLoP, calLoV));
  p.replace("%HI%", calPointText(calHiP, calHiV));
  server.send(200, "text/html; charset=utf-8", p);
}

void handleCal() {
  bool hasV  = server.hasArg("v");
  bool hasLo = server.hasArg("lo");
  bool hasHi = server.hasArg("hi");

  if (!hasV && !hasLo && !hasHi) { handleCalPage(); return; }

  if (!vbatValid)              { server.send(200, "text/plain; charset=utf-8", "Канал бортсети в насыщении"); return; }
  if (vbatMv > ADC_LIN_MAX_MV) { server.send(200, "text/plain; charset=utf-8",
        "Слишком высокое напряжение для калибровки. На выводе АЦП " +
        String(vbatMv) + " мВ, а честно меряется только до " +
        String((int)ADC_LIN_MAX_MV) + ". Возьмите точку пониже — около 12,5 В."); return; }
  if (vbatMv < 200)            { server.send(200, "text/plain; charset=utf-8", "Слишком низкое напряжение"); return; }

  float p = vbatMv / 1000.0;
  String msg;

  if (hasV) {
    float v = server.arg("v").toFloat();
    if (v < 5.0 || v > 20.0) { server.send(200, "text/plain; charset=utf-8", "Вне диапазона 5...20 В"); return; }
    calA = v / p;
    calB = 0;
    calLoP = calHiP = 0;
    msg = "одна точка: наклон " + String(calA, 3) + ", сдвиг обнулён";
  } else {
    float v = server.arg(hasLo ? "lo" : "hi").toFloat();
    if (v < 5.0 || v > 20.0) { server.send(200, "text/plain; charset=utf-8", "Вне диапазона 5...20 В"); return; }
    if (hasLo) { calLoP = p; calLoV = v; } else { calHiP = p; calHiV = v; }

    String why;
    if (calRecompute(why)) msg = "две точки: " + why;
    else                   msg = "точка записана, " + why;
  }

  saveSettings();
  vbat = p * calA + calB;
  addLog("калибровка: " + msg);
  server.send(200, "text/html; charset=utf-8",
              "<meta charset=utf-8><meta http-equiv=refresh content='2;url=/cal'>"
              "<body style='background:#040408;color:#ffc300;"
              "font:15px ui-monospace,monospace;padding:20px'>" + msg);
}

